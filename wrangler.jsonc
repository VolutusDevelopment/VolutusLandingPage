{
  "name": "volutuslandingpage",
  "compatibility_date": "2026-08-17",

  // El Worker existe por una sola ruta, POST /api/contacto (worker/index.js).
  // Cloudflare sirve `dist/` directamente y solo invoca el Worker para /api/* y
  // para lo que no corresponde a ningún archivo, así que la portada no paga
  // nada por que esto exista.
  "main": "worker/index.js",

  "assets": {
    "directory": "./dist",
    // El binding es lo que permite al Worker devolver el sitio estático para
    // cualquier ruta que no sea la suya.
    "binding": "ASSETS",
    // Una ruta que no existe recibe dist/404.html con estado 404.
    "not_found_handling": "404-page",
    // Con la 404 activa, Cloudflare ya no invoca el Worker en una navegación
    // que no encuentra archivo, y el formulario enviado sin JavaScript es una
    // navegación: sin esta línea, recibiría la 404 en vez de llegar aquí.
    "run_worker_first": ["/api/*"]
  },

  // Cinco envíos por minuto desde una misma IP. Nadie escribe más que eso a
  // mano; un robot que encuentre el endpoint sí, y cada envío que pase gasta
  // cuota de Resend y llena la bandeja.
  "ratelimits": [
    {
      "name": "LIMITE_CONTACTO",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "observability": {
    // Los console.error del endpoint son el único aviso de que se están
    // perdiendo mensajes. Sin logs, un fallo de Resend es invisible.
    "enabled": true
  }

  // RESEND_API_KEY NO va aquí: es un secreto y se carga con
  //   wrangler secret put RESEND_API_KEY
  // REMITENTE es opcional y se puede poner como variable normal cuando
  // volutus.cl esté verificado en Resend.
}
